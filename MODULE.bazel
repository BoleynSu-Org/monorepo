        ),
        single_version_override(
            module_name = dep.get(
                "module_name",
                dep["name"],
            ),
            version = dep.get(
                "module_version",
                dep["version"],
            ),
        ),
    ]
    for dep in DEPS["bazel_deps"]
    if dep["type"] == "http_archive"
]

